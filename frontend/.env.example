# Frontend environment variables
#
# Local dev: leave VITE_API_BASE empty. Vite's proxy in vite.config.js
# forwards /api/* to http://127.0.0.1:8765 automatically.
#
# Production (Vercel): set this to your Render backend URL, e.g.:
#   VITE_API_BASE=https://smart-excel-engine.onrender.com
# In Vercel UI: Project → Settings → Environment Variables → add for "Production".
VITE_API_BASE=
